# 复制成 .env 再填。这个文件**不进 git**（仓库根 .gitignore 已经忽略 .env）。

# 会话令牌的签名密钥。换掉它 = 所有设备立刻要重新登录。
# 生成：openssl rand -hex 32
SESSION_SECRET=

# 允许的 Google OAuth 客户端 ID（ID token 的 aud），逗号分隔。
# Web 一个、iOS 一个；Android 用的是 Web 那个，不要把 Android 客户端 ID 填进来。
GOOGLE_CLIENT_IDS=

# 允许登录的邮箱，逗号分隔。**留空服务器拒绝启动** —— 挂在公网上谁登录都给存东西的
# 备份服务器比没有备份糟糕得多。
ALLOWED_EMAILS=

# 允许的浏览器来源，逗号分隔。
#   https://d.gamestao.com  线上 web 版
#   capacitor://localhost   iOS 原生壳
#   https://localhost       Android 原生壳
#   http://localhost:5173   本机开发
ALLOWED_ORIGINS=https://d.gamestao.com,capacitor://localhost,https://localhost,http://localhost:5173

# 容器以哪个 uid/gid 跑。填宿主机上 ./data 的所有者（`id -u` / `id -g`），
# 否则容器写不进挂进去的数据目录。
SYNC_UID=
SYNC_GID=

# 对齐那一半（FR-15.17）。全有默认值，一般不用动。
# ALIGN_ENABLED=true
# 权重变体。fp32 = 未量化那份（1204 MiB，服务器自己从 HF 取）。
# 换成 q4 要自己把量化后的文件放进 data/models/（见 deploy/README.md §4b）。
# ALIGN_MODEL_DTYPE=fp32
# 闲置多久把会话放掉（毫秒，0 = 永不放）。fp32 的会话常驻 2.1 GiB。
# ALIGN_IDLE_MS=600000
# 把 data/models/ 当权重站对外提供（浏览器要的 4-bit 权重只有这儿有）。
# ALIGN_SERVE_WEIGHTS=true
# ALIGN_THREADS=3
# ALIGN_MAX_AUDIO_BYTES=41943040
# ALIGN_MAX_SECONDS=1800
# ALIGN_MAX_QUEUED=3
# ALIGN_RESULT_TTL_MS=1800000

# AI 补充解释（FR-9.11 / FR-9.12）。留空整块关闭 —— 查词面板与生词本的「问 AI」
# 会显示「AI 服务暂时不可用」而不是报错崩溃。https://console.anthropic.com/settings/keys 建一个新 key。
# ANTHROPIC_API_KEY=
# 便宜模型够用：只解释一个词或一句话，不需要强推理能力。
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# 下面几项有默认值，一般不用动。
# PORT=8790
# DATA_DIR=/data
# SESSION_TTL_DAYS=90
# MAX_DOC_BYTES=8388608
# REVISIONS_PER_DOC=30
