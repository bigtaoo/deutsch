<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<!-- 这两处是**兜底**值：真正显示的名字按系统语言取 {zh-Hans,de,en}.lproj/InfoPlist.strings，
	     只有那些文件都没匹配上时才用这里的。别忘了 capacitor.config.ts 里的 appName 跟这里无关
	     （它只在 `npx cap add ios` 建工程时用一次，改它对已有工程没有任何作用）。 -->
	<key>CFBundleDisplayName</key>
        <string>精听</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- 不能留 $(PRODUCT_NAME)：那是 target 名「App」，会原样显示在
	     设置 → 通用 → iPhone 储存空间 / 电池用量 / 通知设置里。
	     CFBundleExecutable 才是二进制名，跟这条无关，所以改这里不影响构建产物。
	     ≤15 个字符，长了系统会截。 -->
	<key>CFBundleName</key>
	<string>精听</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
    <false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
            <key>UISceneConfigurationName</key>
            <string>Default Configuration</string>
            <key>UISceneDelegateClassName</key>
            <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
            <key>UISceneStoryboardFile</key>
            <string>Main</string>
        </dict>
      </array>
    </dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- 摄像头权限已删除（2026-09-02）：它当初只为 FR-11.18 的配对二维码而存在
	     （唯一一处 getUserMedia），而那条需求随 GitHub 备份一起删掉了，
	     见 SPEC §0 变更 25。App 现在一处也不用摄像头，声明一个用不到的权限
	     只会在审核时被问、并在系统设置里给用户看一条假的开关。
	     若哪天又要用摄像头，把 NSCameraUsageDescription 加回来 ——
	     没有它，WKWebView 里的 getUserMedia 不是报错，而是直接崩溃退出。 -->
	<!-- Google 登录（FR-11.1）：把 iOS 客户端 ID 的反向域名注册成 URL scheme，
	     系统浏览器授权完才知道该跳回哪个 App。没有它，登录会跳出去 Safari 然后回不来。
	     这个字符串就是客户端 ID 前后两段调个个，不是另外申请的东西。
	     换 Google 项目 / 换 iOS 客户端时，这里和 .env.local 的
	     VITE_GOOGLE_IOS_CLIENT_ID 必须一起改，只改一边的表现是「点了没反应」。 -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.996386780227-3q7tbo20p6r0744kn7ej0b0d5spl2ep7</string>
			</array>
		</dict>
	</array>
	<!-- 手动导出的 backup-*.json 写在 App 的 Documents 目录（src/lib/download.ts）。
	     这两条让「文件」App 直接看到那个文件夹 —— 否则分享面板一划掉，
	     导出的备份就只存在于一个用户看不见的沙盒目录里。 -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- 只用系统 HTTPS，没有自带加密算法。不声明这条的话每次上传 TestFlight
	     都要在 App Store Connect 手动回答一遍出口合规问题，构建会一直卡在处理中。 -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
